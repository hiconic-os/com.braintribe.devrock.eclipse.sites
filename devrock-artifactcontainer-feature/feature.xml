<?xml version="1.0" encoding="UTF-8"?>
<feature
      id="devrock.eclipse.feature.artifact.container"
      label="Devrock Artifact Container Feature"
      version="4.0.0.qualifier"
      provider-name="Hiconic"
      license-feature="Devrock_License_Feature"
      license-feature-version="1.0.2.0">

   <description url="https://github.com/hiconic-os">
      adds a dynamic classpath container to Java projects, i.e. automatically
updates any links to projects that match dependencies in the
classpath of a project, and updates the classpath upon changes within such a dependency&apos;s project or changes in the workspace.
   </description>

