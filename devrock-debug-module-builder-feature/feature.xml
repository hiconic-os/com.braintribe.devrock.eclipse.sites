<?xml version="1.0" encoding="UTF-8"?>
<feature
      id="devrock.eclipse.feature.debug.module.nature.builder"
      label="Devrock Debug Module Nature Builder Feature"
      version="1.0.0.qualifier"
      provider-name="Hiconic"
      license-feature="Devrock_License_Feature"
      license-feature-version="1.0.2.0">

   <description url="https://github.com/hiconic-os">
      The debug module builder adds a build-step to &apos;debug projects&apos;
as created by Jinni in order to link their dependencies with
possibly matching projects in your workspace so a tribefire instance
can be debugged easily.
   </description>

